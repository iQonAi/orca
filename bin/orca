#!/bin/sh
#
# orca - launcher. Runs the preflight checks, exports the bot's GitHub
# identity and execs `claude --agent orca`.
#
# Usage: orca [--check] [--repo owner/repo] [claude args...]
#        orca init
#   --check            run the checks, print the results, exit 0/1; launch
#                      nothing, write nothing
#   --repo owner/repo  check this repository instead of the one detected from
#                      the origin remote of the current directory
#   --help             usage
#   init               write .orca/project.json for this checkout and open a
#                      PR with it; see orca_init below
#   Anything else is passed through to claude.
#
# Orca acts as a GitHub account of its own. Its token lives in
# ${XDG_CONFIG_HOME:-~/.config}/orca/token (ORCA_TOKEN_FILE overrides), is
# read only here and is never printed; nothing else on the machine changes
# account. Every check runs before the launch is decided, so one run names
# every failure. On success GH_TOKEN and the git author/committer identity
# (ORCA_GIT_NAME / ORCA_GIT_EMAIL, else the login and its
# <id>+<login>@users.noreply.github.com address) are exported and claude
# replaces this process: gh, git, the watcher and every worker inherit them.
#
# Per-machine variables such as LINEAR_API_KEY live in
# ${XDG_CONFIG_HOME:-~/.config}/orca/orca.env (ORCA_ENV_FILE overrides), held
# to the token file's mode rule. A missing file is skipped; a dangling
# symlink or an unreadable file fails. Each line is KEY=value, taken
# literally: no quotes, no expansion, never run as shell; one trailing CR is
# dropped. Blank lines and lines starting with # are skipped. A variable
# already set in the environment that started the launcher, or exported by
# the launcher itself (GH_TOKEN, the git identity), wins over the file, and
# for a key the file repeats, the first line wins. The values go to claude's
# environment only, never into this shell, and are never printed; the
# launcher's own settings (ORCA_TOKEN_FILE, ORCA_STYLE, ...) are read from
# the environment only.
#
# Checks, in order (each prints `ok:` or `fail:` with the reason):
#   1. tools     gh, git, jq, claude and printenv on PATH
#   2. identity  the token file exists, is not empty and is mode 0600 or 0400
#                (a file group or world can read is refused, unread); gh api
#                user succeeds with it - `running as <login>`
#   3. env       the env file, if present, is mode 0600 or 0400 and every
#                line is blank, a comment or KEY=value with a valid name
#   4. repo      owner/repo from the checkout's origin remote (or --repo); the
#                bot's permission on it is write, maintain or admin
#   5. install   the playbook, the SessionStart hook, the watcher and the
#                project data reader resolve to real files - a dangling
#                symlink is named - and, claude style, the hook is wired in
#                settings.json by the installer's own identity rule (an
#                entry whose command is the hook path, in the ~ or the
#                absolute spelling)
#   6. instance  no live orca holds this repository's session record
#
# Session record: <config>/orca/sessions/<repo-slug> holds the pid of the
# orca running for that repository. `exec` replaces this shell, so no EXIT
# trap of its own can outlive the launch: a detached subshell polls the pid
# instead and removes the record when it dies. A record naming a dead pid, or
# a live pid whose command line is not an orca launch, is stale and never
# blocks a launch.

set -u

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/orca"
TOKEN_FILE="${ORCA_TOKEN_FILE:-$CONFIG_DIR/token}"
ENV_FILE="${ORCA_ENV_FILE:-$CONFIG_DIR/orca.env}"
SESSIONS_DIR="$CONFIG_DIR/sessions"
CH="${CLAUDE_HOME:-$HOME/.claude}"
# as in install.sh: `/x/` names the same home as `/x`
CH="${CH%"${CH##*[!/]}"}"
BIN="${ORCA_BIN:-$HOME/.local/bin}"
INIT_BRANCH=chore/orca-init
PROJECT_FILE=.orca/project.json

usage() {
  cat <<EOF
usage: orca [--check] [--repo owner/repo] [claude args...]
       orca init

Runs the preflight checks, exports the bot's GitHub identity and execs
claude --agent orca. Every check runs before the launch is decided.

  --check            run the checks and exit: 0 when all pass, 1 otherwise;
                     launch nothing, write nothing
  --repo owner/repo  check this repository instead of the one detected from
                     the origin remote of the current directory
  --help             this text

Anything else is passed through to claude.

orca init asks for the project's values (name, tracker, GitHub repo, and the
Linear team and project for the linear tracker), proposing defaults from the
origin remote, then commits .orca/project.json on a new branch
$INIT_BRANCH, made from origin's default branch in a worktree of its own,
pushes it to origin and opens a PR against the default branch with gh. It
never commits to the checked-out branch, and it refuses to run when the file
or the branch already exists.

Files
  $TOKEN_FILE
      the bot's token, mode 0600 or 0400 (ORCA_TOKEN_FILE overrides)
  $ENV_FILE
      optional KEY=value lines exported to claude, mode 0600 or 0400; a
      variable already in the environment wins (ORCA_ENV_FILE overrides)
  $SESSIONS_DIR/<repo-slug>
      pid of the orca running for that repository

Environment
  ORCA_GIT_NAME, ORCA_GIT_EMAIL  git identity; default: the login, and
                                 <id>+<login>@users.noreply.github.com
  ORCA_STYLE                     claude or agents; skips install detection
  CLAUDE_HOME, ORCA_BIN          where the install check looks
                                 (~/.claude and ~/.local/bin)
EOF
}

# --- init --------------------------------------------------------------------
# orca init: writes the project data file and opens a PR with it. Every
# refusal comes before the first question, and every answer is validated by
# the reader before the user's repository is touched:
#   - the file must not exist in the working tree, in HEAD or on origin's
#     default branch, and $INIT_BRANCH must exist neither locally nor on
#     origin, so an earlier run or a hand-written file is never replaced and
#     a second run never fails late at the push;
#   - the proposals are the reader's own no-file defaults, so init and the
#     consumers agree on what "no file" means;
#   - the candidate is written to a scratch repository and read back field by
#     field by the reader; a value the reader rejects ends the run with its
#     reason and nothing written;
#   - the commit is made in a worktree of its own on $INIT_BRANCH, branched
#     from origin's default branch as just fetched, never from HEAD: a run
#     from a feature branch, or from a local main ahead of origin, must not
#     push those commits or put them in the PR. The checked-out branch and
#     the working tree never change. The branch is pushed to origin and the
#     PR opened against the default branch with the caller's own git and gh
#     credentials: init is a setup step the user runs, and it reads no bot
#     token.
# Answers come from stdin, one line each; an empty line keeps the proposal.
# End of input before the last answer stops the run with nothing written.
init_die() {
  echo "orca init: $*" >&2
  exit 1
}
# $1 the reader's name for the field, $2 the proposal; the answer in $ans
ask() {
  if [ -n "$2" ]; then
    printf '%s [%s]: ' "$1" "$2"
  else
    printf '%s: ' "$1"
  fi
  ans=
  if ! read -r ans && [ -z "$ans" ]; then
    echo
    init_die "no answer for $1 (end of input); nothing written"
  fi
  [ -n "$ans" ] || ans=$2
}
orca_init() {
  [ $# -eq 0 ] || init_die "takes no arguments (got: $*)"
  for t in git gh jq; do
    command -v "$t" >/dev/null 2>&1 || init_die "$t not on PATH"
  done
  # The reader as installed (claude style, then agents style), else the one
  # beside this launcher in a checkout.
  reader=
  for r in "$CH/scripts/orca-project.sh" "$BIN/orca-project" "${0%/*}/../scripts/orca-project.sh"; do
    if [ -f "$r" ]; then
      reader=$r
      break
    fi
  done
  [ -n "$reader" ] || init_die "scripts/orca-project.sh not found under $CH/scripts or $BIN; run install.sh"
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=
  [ -n "$root" ] || init_die "not inside a git repository"
  if [ -e "$root/$PROJECT_FILE" ] || [ -L "$root/$PROJECT_FILE" ] ||
    git -C "$root" cat-file -e "HEAD:$PROJECT_FILE" 2>/dev/null; then
    init_die "$root/$PROJECT_FILE already exists; edit it on a branch instead"
  fi
  if git -C "$root" rev-parse -q --verify "refs/heads/$INIT_BRANCH" >/dev/null; then
    init_die "branch $INIT_BRANCH already exists; delete it or finish its PR first"
  fi
  origin_repo=$(cd "$root" && sh "$reader" github.repo) ||
    init_die "no owner/repo from the origin remote; add one first"
  # Asked of origin itself, not of a remote-tracking ref that may be stale or
  # absent (a fetch does not set refs/remotes/origin/HEAD).
  sym=$(git -C "$root" ls-remote --symref origin HEAD) ||
    init_die "could not reach origin to find its default branch"
  case "$sym" in
    "ref: refs/heads/"*) ;;
    *) init_die "origin names no default branch" ;;
  esac
  default=${sym#ref: refs/heads/}
  default=${default%%[[:space:]]*}
  git -C "$root" ls-remote --exit-code --heads origin "refs/heads/$INIT_BRANCH" >/dev/null
  case $? in
    0) init_die "origin already has a branch $INIT_BRANCH; finish or close its PR and delete that branch first" ;;
    2) ;;
    *) init_die "could not list the branches on origin" ;;
  esac
  git -C "$root" fetch -q origin "+refs/heads/$default:refs/remotes/origin/$default" ||
    init_die "could not fetch $default from origin"
  base=$(git -C "$root" rev-parse -q --verify "refs/remotes/origin/$default^{commit}") ||
    init_die "origin/$default has no commit to branch from"
  if git -C "$root" cat-file -e "$base:$PROJECT_FILE" 2>/dev/null; then
    init_die "origin/$default already has $PROJECT_FILE; pull it instead"
  fi

  echo "Project data for $root ($PROJECT_FILE). Press enter to keep a proposal."
  ask name "${origin_repo##*/}"
  name=$ans
  ask tracker "$(cd "$root" && sh "$reader" tracker)"
  tracker=$ans
  ask github.repo "$origin_repo"
  repo=$ans
  team=
  project=
  if [ "$tracker" = linear ]; then
    ask linear.team ""
    team=$ans
    ask 'linear.project (optional, enter for none)' ""
    project=$ans
  fi
  json=$(jq -n --arg name "$name" --arg tracker "$tracker" --arg repo "$repo" \
    --arg team "$team" --arg project "$project" '
    {version: 1, name: $name, tracker: $tracker, github: {repo: $repo}}
    + if $tracker == "linear" then
        {linear: ({team: $team} + if $project == "" then {} else {project: $project} end)}
      else {} end') || init_die "could not build the JSON"

  tmp=$(mktemp -d) || init_die "could not make a temp directory"
  check="$tmp/check"
  if ! { mkdir -p "$check/.orca" && git init -q "$check" &&
    printf '%s\n' "$json" >"$check/$PROJECT_FILE"; }; then
    init_die "could not write the candidate under $tmp"
  fi
  fields="tracker name github.repo"
  [ "$tracker" != linear ] || fields="$fields linear.team linear.project"
  for f in $fields; do
    if ! err=$(cd "$check" && sh "$reader" "$f" 2>&1 >/dev/null); then
      rm -rf "$tmp"
      init_die "${err#orca-project.sh: "$check/$PROJECT_FILE": }; nothing written"
    fi
  done

  wt="$tmp/worktree"
  git -C "$root" worktree add -q -b "$INIT_BRANCH" "$wt" "$base" ||
    init_die "could not add a worktree on $INIT_BRANCH"
  left="the worktree $wt and the branch $INIT_BRANCH are left in place; clean up with: git worktree remove --force $wt && git branch -D $INIT_BRANCH"
  if ! { mkdir -p "$wt/.orca" && cp "$check/$PROJECT_FILE" "$wt/$PROJECT_FILE"; }; then
    init_die "could not write $PROJECT_FILE in $wt; $left"
  fi
  if ! { git -C "$wt" add -- "$PROJECT_FILE" &&
    git -C "$wt" commit -q -m "chore: add the orca project data file" -- "$PROJECT_FILE"; }; then
    init_die "could not commit $PROJECT_FILE; $left"
  fi
  git -C "$wt" push -q origin "$INIT_BRANCH" ||
    init_die "could not push $INIT_BRANCH to origin; $left"
  url=$(cd "$wt" && gh pr create --repo "$origin_repo" --head "$INIT_BRANCH" --base "$default" \
    --title "chore: add the orca project data file" \
    --body "Adds \`$PROJECT_FILE\`, written by \`orca init\`. It holds no secrets.") ||
    init_die "could not open the PR; $INIT_BRANCH is pushed. $left"
  echo "wrote $PROJECT_FILE on $INIT_BRANCH and opened $url"
  if git -C "$root" worktree remove "$wt"; then
    rm -rf "$tmp"
  else
    echo "note: could not remove the worktree $wt; remove it with: git worktree remove --force $wt" >&2
  fi
}
if [ "${1:-}" = init ]; then
  shift
  orca_init "$@"
  exit 0
fi

CHECK=0
REPO=
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --repo)
      if [ $# -lt 2 ]; then
        echo "orca: --repo needs owner/repo" >&2
        exit 2
      fi
      shift
      REPO=$1
      ;;
    --repo=*) REPO=${1#--repo=} ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *) break ;;
  esac
  shift
done

FAILS=0
ok() { echo "ok: $*"; }
fail() {
  echo "fail: $*"
  FAILS=$((FAILS + 1))
}
NL=$(printf '\nx')
NL=${NL%x}
first_line() { printf '%s\n' "${1%%"$NL"*}"; }

# --- 1. tools ----------------------------------------------------------------
tools_ok=1
for t in gh git jq claude printenv; do
  if ! command -v "$t" >/dev/null 2>&1; then
    fail "tools: $t not on PATH"
    tools_ok=0
  fi
done
if [ "$tools_ok" = 1 ]; then
  ok "tools: gh, git, jq, claude, printenv on PATH"
fi

# --- 2. identity -------------------------------------------------------------
# Permission bits in octal: GNU stat first, BSD stat second. -L: a token file
# that is a symlink is judged by the file it points at.
file_mode() {
  stat -L -c '%a' "$1" 2>/dev/null || stat -L -f '%Lp' "$1" 2>/dev/null
}
token=
login=
uid=
if [ ! -f "$TOKEN_FILE" ]; then
  fail "token: $TOKEN_FILE is missing; store the bot's token there, then run: chmod 600 $TOKEN_FILE"
elif [ ! -s "$TOKEN_FILE" ]; then
  fail "token: $TOKEN_FILE is empty"
else
  mode=$(file_mode "$TOKEN_FILE")
  case "$mode" in
    600 | 0600 | 400 | 0400)
      ok "token: $TOKEN_FILE (mode 0${mode#0})"
      token=$(cat "$TOKEN_FILE")
      ;;
    *)
      fail "token: $TOKEN_FILE is mode ${mode:-unknown}, not 0600 or 0400 (group or other can read it); run: chmod 600 $TOKEN_FILE"
      ;;
  esac
fi
if [ -n "$token" ]; then
  if out=$(GH_TOKEN="$token" gh api user --jq '"\(.login) \(.id)"' 2>&1) && [ -n "$out" ]; then
    login=${out%% *}
    uid=${out#* }
    # stderr is merged into $out, so anything gh prints beside a success
    # lands in the API path below and in the git identity. Both halves are
    # checked: the id is digits, the login is a GitHub login ([A-Za-z0-9-]).
    # A warning line with no space in it is absorbed by the login and leaves
    # the id numeric, so the id check alone is not enough.
    ident_ok=1
    case "$uid" in '' | *[!0-9]*) ident_ok=0 ;; esac
    case "$login" in '' | *[!A-Za-z0-9-]*) ident_ok=0 ;; esac
    if [ "$ident_ok" = 1 ]; then
      ok "running as $login"
    else
      fail "identity: unexpected gh api user output"
      login=
      uid=
    fi
  else
    fail "identity: gh api user failed with the token in $TOKEN_FILE: $(first_line "$out")"
  fi
else
  fail "identity: not checked (no usable token)"
fi

# --- 3. env ------------------------------------------------------------------
env_lines=
CR=$(printf '\r')
if [ -L "$ENV_FILE" ] && [ ! -e "$ENV_FILE" ]; then
  fail "env: $ENV_FILE is a dangling symlink to $(readlink "$ENV_FILE")"
elif [ ! -e "$ENV_FILE" ]; then
  ok "env: $ENV_FILE absent; skipped"
elif [ ! -f "$ENV_FILE" ] || [ ! -r "$ENV_FILE" ]; then
  fail "env: $ENV_FILE is not a readable file"
else
  mode=$(file_mode "$ENV_FILE")
  case "$mode" in
    600 | 0600 | 400 | 0400)
      n=0
      bad=
      while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line=${line%"$CR"}
        t=${line#"${line%%[![:space:]]*}"}
        case "$t" in '' | '#'*) continue ;; esac
        key=${line%%=*}
        case "$line" in
          *=*)
            case "$key" in
              '' | [0-9]* | *[!A-Za-z0-9_]*) bad="$bad $n" ;;
              *) env_lines="$env_lines$line$NL" ;;
            esac
            ;;
          *) bad="$bad $n" ;;
        esac
      done <"$ENV_FILE"
      if [ -n "$bad" ]; then
        fail "env: $ENV_FILE line(s)$bad not KEY=value with a valid variable name"
      else
        ok "env: $ENV_FILE (mode 0${mode#0})"
      fi
      ;;
    *)
      fail "env: $ENV_FILE is mode ${mode:-unknown}, not 0600 or 0400 (group or other can read it); run: chmod 600 $ENV_FILE"
      ;;
  esac
fi

# --- 4. repo -----------------------------------------------------------------
# Local, like the SessionStart hook: parsed from the origin remote, so a
# repository the bot cannot see is still named, and the permission check
# below says why rather than "no repo".
repo_from_origin() {
  url=$(git config --get remote.origin.url 2>/dev/null) || return 1
  [ -n "$url" ] || return 1
  p=${url%.git}
  p=${p#*://*/} # https://host/owner/repo -> owner/repo
  p=${p#*:}     # git@host:owner/repo -> owner/repo
  case "$p" in */*) ;; *) return 1 ;; esac
  name=${p##*/}
  rest=${p%/*}
  owner=${rest##*/}
  [ -n "$owner" ] && [ -n "$name" ] || return 1
  printf '%s/%s\n' "$owner" "$name"
}
if [ -n "$REPO" ]; then
  repo=$REPO
else
  repo=$(repo_from_origin) || repo=
fi
# The shape is checked before the value reaches an API path: exactly one
# slash, neither side empty or a dot-name, and nothing GitHub would not put
# in an owner or a repository name.
case "$repo" in
  "") fail "repo: not detected from the current directory (no origin remote); pass --repo owner/repo" ;;
  */*/* | */ | /* | ./* | ../* | */. | */.. | *[!A-Za-z0-9._/-]*)
    fail "repo: '$repo' is not owner/repo"
    repo=
    ;;
  */*) ;;
  *)
    fail "repo: '$repo' is not owner/repo"
    repo=
    ;;
esac
if [ -n "$repo" ]; then
  if [ -z "$login" ]; then
    fail "repo: $repo; the bot's permission was not checked (identity check failed)"
  elif perm=$(GH_TOKEN="$token" gh api "repos/$repo/collaborators/$login/permission" --jq .permission 2>&1); then
    case "$perm" in
      write | maintain | admin) ok "repo: $repo ($login has $perm access)" ;;
      *) fail "repo: $login has ${perm:-no} access on $repo; write, maintain or admin is needed" ;;
    esac
  else
    fail "repo: could not read $login's permission on $repo: $(first_line "$perm")"
  fi
fi

# --- 5. install --------------------------------------------------------------
style=${ORCA_STYLE:-}
case "$style" in
  claude | agents) ;;
  *)
    if [ -e "$CH/agents/orca.md" ] || [ -L "$CH/agents/orca.md" ]; then
      style=claude
    elif [ -e "$BIN/gh-watch" ] || [ -L "$BIN/gh-watch" ] || [ -e "$HOME/.config/orca/AGENTS.md" ]; then
      style=agents
    else
      style=
    fi
    ;;
esac
# -f follows a link, so a link to a real file passes; a dangling one is named
# with its target, because the fix is a re-install or a repaired checkout.
check_file() {
  if [ -L "$1" ] && [ ! -e "$1" ]; then
    fail "install: $1 is a dangling symlink to $(readlink "$1")"
    return 1
  fi
  if [ ! -f "$1" ]; then
    fail "install: $1 is missing"
    return 1
  fi
  return 0
}
case "$style" in
  claude)
    files_ok=1
    for f in "$CH/agents/orca.md" "$CH/hooks/orca-start-watcher.sh" "$CH/scripts/gh-watch.sh" "$CH/scripts/orca-project.sh"; do
      check_file "$f" || files_ok=0
    done
    if [ "$files_ok" = 1 ]; then
      ok "install: claude style; playbook, hook, watcher and project reader in place under $CH"
    fi
    # Wired means an entry whose hooks[].command is the hook path, in either
    # spelling the installer knows (install.sh wire_claude_hook): the ~ form
    # it writes for the default home, and the absolute form.
    hook_abs="$CH/hooks/orca-start-watcher.sh"
    if [ "$CH" = "$HOME/.claude" ]; then
      # shellcheck disable=SC2088
      hook_tilde='~/.claude/hooks/orca-start-watcher.sh'
    else
      hook_tilde=$hook_abs
    fi
    if [ ! -f "$CH/settings.json" ]; then
      fail "install: $CH/settings.json is missing, so no SessionStart hook is wired (run install.sh)"
    elif ! command -v jq >/dev/null 2>&1; then
      fail "install: cannot read $CH/settings.json without jq"
    else
      jq -e --arg a "$hook_tilde" --arg b "$hook_abs" \
        'any((.hooks.SessionStart // [])[] | objects | .hooks[]? | objects | .command; . == $a or . == $b)' \
        "$CH/settings.json" >/dev/null 2>&1
      case $? in
        0) ok "install: SessionStart hook wired in $CH/settings.json" ;;
        1) fail "install: no SessionStart hook for orca-start-watcher.sh in $CH/settings.json (run install.sh)" ;;
        *) fail "install: $CH/settings.json is not valid JSON" ;;
      esac
    fi
    ;;
  agents)
    files_ok=1
    for f in "$BIN/gh-watch" "$BIN/orca-project" "$HOME/.config/orca/AGENTS.md"; do
      check_file "$f" || files_ok=0
    done
    if [ "$files_ok" = 1 ]; then
      ok "install: agents style; watcher, project reader and playbook in place"
    fi
    ;;
  *)
    fail "install: no orca install found (neither $CH/agents/orca.md nor $BIN/gh-watch); run install.sh"
    ;;
esac

# --- 6. instance -------------------------------------------------------------
# Same slug as the watcher's pidfile. A pid is an incumbent only if it is
# alive AND its command line is an orca launch (pids get recycled), and it
# is never this process (a recycled pid could be our own). An orca launch is
# a `claude` command token with `--agent orca` or `--agent=orca` after it;
# `vim orca` or `less notes/orca` at a recycled pid is not one.
live_orca() {
  case "$1" in '' | *[!0-9]*) return 1 ;; esac
  [ "$1" != "$$" ] || return 1
  kill -0 "$1" 2>/dev/null || return 1
  ps -ww -o args= -p "$1" 2>/dev/null |
    grep -qE '(^|[[:space:]/])claude([[:space:]].*)?[[:space:]]--agent(=|[[:space:]]+)orca([[:space:]]|$)'
}
record=
if [ -n "$repo" ]; then
  record="$SESSIONS_DIR/$(printf '%s' "$repo" | tr -c 'A-Za-z0-9._-' '_')"
  incumbent=$(cat "$record" 2>/dev/null)
  if live_orca "$incumbent"; then
    fail "instance: orca already running for $repo (pid $incumbent)"
  else
    ok "instance: no other orca running for $repo"
  fi
else
  fail "instance: not checked (no repo)"
fi

# --- decide ------------------------------------------------------------------
if [ "$FAILS" -gt 0 ]; then
  if [ "$CHECK" = 1 ]; then
    echo "$FAILS check(s) failed"
  else
    echo "$FAILS check(s) failed; not launching orca"
  fi
  exit 1
fi
if [ "$CHECK" = 1 ]; then
  echo "all checks passed"
  exit 0
fi

# --- launch ------------------------------------------------------------------
mkdir -p "$SESSIONS_DIR" 2>/dev/null
if ! printf '%s\n' "$$" >"$record" 2>/dev/null; then
  echo "orca: could not write the session record $record" >&2
  exit 1
fi
# The janitor: detached from the terminal's stdio so a caller capturing our
# output is not held open, deaf to the terminal's signals so it outlives a
# closed window, and it removes only a record that still names this pid.
(
  trap '' HUP INT TERM
  while kill -0 "$$" 2>/dev/null; do sleep 1; done
  [ "$(cat "$record" 2>/dev/null)" = "$$" ] && rm -f "$record"
) </dev/null >/dev/null 2>&1 &

GH_TOKEN=$token
GIT_AUTHOR_NAME=${ORCA_GIT_NAME:-$login}
GIT_AUTHOR_EMAIL=${ORCA_GIT_EMAIL:-$uid+$login@users.noreply.github.com}
GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME
GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
export GH_TOKEN GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
# After the identity, so the file cannot replace GH_TOKEN or the git identity.
# printenv sees exported variables only, not the launcher's own. The first
# line for a key wins.
keep=
names=" "
while IFS= read -r line; do
  [ -n "$line" ] || continue
  key=${line%%=*}
  case "$names" in *" $key "*) continue ;; esac
  names="$names$key "
  printenv "$key" >/dev/null || keep="$keep$line$NL"
done <<EOF
$env_lines
EOF
# No file line is ever assigned in this shell: bash evaluates some names
# (RANDOM, OPTIND, ...) as arithmetic on assignment, and EXECIGNORE would
# change the PATH search for claude. The lines go to env as arguments, as
# plain data, and env finds claude by the environment's PATH:
#   env KEY=value... claude --agent orca <claude args>
set -- claude --agent orca "$@"
k=$#
IFS=$NL
set -f
for line in $keep; do set -- "$@" "$line"; done
while [ "$k" -gt 0 ]; do
  set -- "$@" "$1"
  shift
  k=$((k - 1))
done
exec env "$@"
